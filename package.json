{
  "name": "proyecto-restaurantes-microservicios",
  "version": "1.0.0",
  "description": "Orquestador de microservicios Proyecto Restaurantes",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "install:services": "node Backend-Restaurante/scripts/install.js",
    "dev": "node Backend-Restaurante/scripts/dev.js",
    "dev:auth": "pnpm --dir Backend-Restaurante/AuthService dev",
    "dev:restaurantes": "pnpm --dir Backend-Restaurante/RestaurantesService dev",
    "dev:pedidos": "pnpm --dir Backend-Restaurante/PedidosReservacionesService dev",
    "dev:eventos": "pnpm --dir Backend-Restaurante/EventosReportesService dev",
    "dev:frontend": "pnpm --dir Frontend-Restaurante dev",
    "dev:all": "node Backend-Restaurante/scripts/dev.js",
    "db:up": "docker-compose -f Backend-Restaurante/docker-compose.yml up -d",
    "db:down": "docker-compose -f Backend-Restaurante/docker-compose.yml down"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23"
  }
}